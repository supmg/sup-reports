{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:slug/:year(\\d{4})/:month/:file", "destination": "/reports/:slug/:year/:month/:file" },
    { "source": "/:slug/:year(\\d{4})/:month", "destination": "/reports/:slug/:year/:month" }
  ],
  "headers": [
    {
      "source": "/reports/:slug/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://sup.co/reports",
      "permanent": false
    }
  ]
}
