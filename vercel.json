{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "reports.sup.co"
        }
      ],
      "destination": "https://sup.co/research",
      "permanent": true
    },
    {
      "source": "/brands/:slug/:year(\\d{4})/:month",
      "has": [
        {
          "type": "host",
          "value": "reports.sup.co"
        }
      ],
      "destination": "https://sup.co/research/brands/:slug/:year/:month",
      "permanent": true
    },
    {
      "source": "/brands/:slug/:year(\\d{4})/:month/:file*",
      "has": [
        {
          "type": "host",
          "value": "reports.sup.co"
        }
      ],
      "destination": "https://sup.co/research/brands/:slug/:year/:month/:file*",
      "permanent": true
    },
    {
      "source": "/niches/:slug/:year(\\d{4})/:month",
      "has": [
        {
          "type": "host",
          "value": "reports.sup.co"
        }
      ],
      "destination": "https://sup.co/research/niches/:slug/:year/:month",
      "permanent": true
    },
    {
      "source": "/niches/:slug/:year(\\d{4})/:month/:file*",
      "has": [
        {
          "type": "host",
          "value": "reports.sup.co"
        }
      ],
      "destination": "https://sup.co/research/niches/:slug/:year/:month/:file*",
      "permanent": true
    },
    {
      "source": "/:slug/:year(\\d{4})/:month",
      "has": [
        {
          "type": "host",
          "value": "reports.sup.co"
        }
      ],
      "destination": "https://sup.co/research/brands/:slug/:year/:month",
      "permanent": true
    },
    {
      "source": "/:slug/:year(\\d{4})/:month/:file*",
      "has": [
        {
          "type": "host",
          "value": "reports.sup.co"
        }
      ],
      "destination": "https://sup.co/research/brands/:slug/:year/:month/:file*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/brands/:slug/:year(\\d{4})/:month/:file*",
      "destination": "/reports/brands/:slug/:year/:month/:file*"
    },
    {
      "source": "/brands/:slug/:year(\\d{4})/:month",
      "destination": "/reports/brands/:slug/:year/:month"
    },
    {
      "source": "/niches/:slug/:year(\\d{4})/:month/:file*",
      "destination": "/reports/niches/:slug/:year/:month/:file*"
    },
    {
      "source": "/niches/:slug/:year(\\d{4})/:month",
      "destination": "/reports/niches/:slug/:year/:month"
    }
  ],
  "headers": [
    {
      "source": "/reports/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
